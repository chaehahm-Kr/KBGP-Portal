# ------------------------------------------------------------------
# K Select Network 파트너 포털 — 환경변수 템플릿
# 이 파일을 복사해서 .env.local을 만들고 실제 값을 채워주세요.
#   cp .env.local.example .env.local
# .env.local은 .gitignore에 의해 절대 git에 커밋되지 않습니다.
# ------------------------------------------------------------------

# --- Supabase 프로젝트 연결 정보 ---
# Supabase 대시보드 > 해당 프로젝트 > Project Settings > API Keys 에서 확인
# https://supabase.com/dashboard 에서 무료로 새 프로젝트를 만들 수 있습니다.

# 프로젝트 고유 주소. Project Settings > General(또는 상단 Connect 버튼)에서 확인.
# 브라우저에서도 접근하므로 NEXT_PUBLIC_ 접두사 필요.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# "Publishable key" (API Keys > Publishable and secret API keys 탭).
# 브라우저에 노출되어도 안전하도록 설계된 키입니다
# (실제 데이터 접근 제한은 데이터베이스의 RLS 정책이 담당합니다).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# "Secret key" (API Keys > Secret keys, 구 service_role 키의 후속 버전).
# RLS를 우회하는 관리자 권한 키이므로 절대 NEXT_PUBLIC_ 접두사를 붙이지 말고,
# 서버 코드에서만 사용하세요 (직원 계정 강제 로그아웃 등 제한된 용도로만 사용).
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# --- 이 포털이 배포된 주소 ---
# 로컬 개발 시에는 http://localhost:3000
# 운영 배포 시에는 https://portal.kselectnetwork.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- 업무 알림 이메일 발송 (선택) ---
# 심사 결과 확정 등 커스텀 알림 이메일을 실제로 보내려면 필요합니다.
# 비워두면 실제 발송 대신 개발 서버 콘솔에 로그만 남습니다.
# https://resend.com 에서 무료로 시작할 수 있습니다.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=

# --- 추가 자료 회신 기한 리마인드 cron 인증 (운영 배포 시 필수) ---
# vercel.json의 크론이 /api/cron/info-request-reminders를 호출할 때 이 값과 대조합니다.
# 로컬 개발에서는 비워둬도 동작합니다(운영 환경에서만 필수로 요구).
CRON_SECRET=

# --- 마케팅 사이트 신청 접수 연동 인증 (운영 배포 시 필수) ---
# kselectnetwork.com의 /api/applications가 이 포털의 /api/inquiries를 호출할 때
# Authorization: Bearer <값>으로 보내는 것과 대조합니다. 마케팅 사이트(KBeautyWebsite/web)
# 쪽 .env에도 같은 값을 INQUIRY_INTAKE_SECRET으로 설정해야 합니다.
INQUIRY_INTAKE_SECRET=
